# AI秘書エージェント 環境変数テンプレート
# このファイルをコピーして .env という名前で保存し、各値を設定してください。
# .env ファイルは .gitignore に追加して絶対にコミットしないこと。

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub Personal Access Token
# 取得方法: https://github.com/settings/tokens → Fine-grained tokens
# 必要なスコープ: repo（read/write）, pull_requests（read/write）, issues（read/write）
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backlog ──────────────────────────────────────────────────────────────────
# Backlog APIキー
# 取得方法: {スペース}.backlog.jp → 個人設定 → APIキー
BACKLOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backlogスペース名（.backlog.jp の前の部分のみ）
# 例: yourcompany.backlog.jp の場合は "yourcompany"
BACKLOG_SPACE=yourcompany

# ── Brave Search ─────────────────────────────────────────────────────────────
# Brave Search API キー
# 取得方法: https://brave.com/search/api/ → サブスクリプション登録
BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
