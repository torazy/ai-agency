{
  "$comment": "AI秘書の物理ガードレール（Claude Code 適応層）。正典は memory/guardrails.json。deny は最後の砦であり、緩和は /propose-delegation の承認プロセスを経て permissions.allow に追記する（deny は原則編集しない）。",
  "permissions": {
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*git reset --hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DELETE FROM*)",
      "Bash(*TRUNCATE*)",
      "Bash(*| sh*)",
      "Bash(*| bash*)",
      "Bash(*terraform apply*)",
      "Bash(*kubectl delete*)",
      "Bash(*Remove-Item * -Recurse*)",
      "Bash(*firebase deploy*)",
      "Bash(*serverless deploy*)",
      "Bash(*passwd*)",
      "PowerShell(*Remove-Item * -Recurse*)",
      "PowerShell(*git push --force*)",
      "PowerShell(*git reset --hard*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)"
    ],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/guardrail.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/task-log-writer.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
