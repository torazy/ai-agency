# Git管理から除外するファイル

# 認証情報・秘密情報
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# タスクログ（個人情報を含む可能性あり）
memory/task-log/

# 無人実行の生成物（朝のブリーフ・任せたタスクの報告・取り込み範囲）。再生成でき、端末ごとの状態
memory/briefs/
memory/task-results/
memory/sync-state.json

# OS
.DS_Store
Thumbs.db

# Claude Code ローカル設定（端末固有・権限承認のたびに変化）
.claude/settings.local.json

# 本体メンテナンス層（tools/dev/enable-maintenance.py が本体フォルダにだけ生成する。インスタンスには存在させない）
.ai-agency-template
/CLAUDE.local.md
/.claude/skills/maint-*/

# 書き込みのロックと一時ファイル（mem.py）
memory/.mem.lock
memory/**/.*.tmp

# ZIP で更新するインスタンス用（update_instance.py が作る。git 管理のインスタンスでは使わない）
.ai-agency-core.json
.ai-agency-backup/
