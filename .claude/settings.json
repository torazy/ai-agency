{
  "$comment": "AI秘書の物理ガードレール＋自動記録（Claude Code 適応層）。正典は memory/guardrails.json。deny は最後の砦であり、緩和は /propose-delegation の承認プロセスを経て permissions.allow に追記する（deny は原則編集しない）。フック：SessionStart=記憶の育成状態を注入 / PreToolUse=deny 操作を物理ブロック / PostToolUse(Failure)=外部書き込み・送信を task-log に自動記録（/propose-delegation の集計対象）。",
  "permissions": {
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*git reset --hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DELETE FROM*)",
      "Bash(*TRUNCATE*)",
      "Bash(*| sh*)",
      "Bash(*| bash*)",
      "Bash(*terraform apply*)",
      "Bash(*kubectl delete*)",
      "Bash(*Remove-Item * -Recurse*)",
      "Bash(*firebase deploy*)",
      "Bash(*serverless deploy*)",
      "Bash(*passwd*)",
      "PowerShell(*Remove-Item * -Recurse*)",
      "PowerShell(*git push --force*)",
      "PowerShell(*git reset --hard*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)"
    ],
    "allow": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/session-start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/guardrail.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/guardrail.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/guardrail.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/agent-activity.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/permission-marker.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/operation-logger.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/agent-activity.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/operation-logger.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/agent-activity.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/py.sh tools/hooks/agent-activity.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
